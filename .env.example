# Local dev: copy to .env.local (gitignored -- Vite loads it automatically, `npm run dev` picks
# it up on start). Production/preview: set these as Vercel project environment variables instead
# of committing a real .env file -- see deployment-vercel.md.
#
# Both are VITE_-prefixed so Vite inlines them into the built client bundle -- see src/lib/env.ts
# for what that does and doesn't mean for secrecy.

# The wabtec_poc backend this app talks to.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Must match that backend's own API_ACCESS_KEY env var exactly.
VITE_API_ACCESS_KEY=<the backend's API_ACCESS_KEY value>
